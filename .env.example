# Copy to .env and fill in. run_local.sh and deploy.sh both source it.

# Your GCP project (falls back to `gcloud config get-value project`)
GOOGLE_CLOUD_PROJECT=""

# Region for Vertex AI / Cloud Run. Keep "global" for local Vertex calls;
# deploy.sh falls back to your gcloud compute/region (or us-central1).
GOOGLE_CLOUD_LOCATION="global"

# Use Vertex AI for Gemini calls (recommended for the workshop).
GOOGLE_GENAI_USE_VERTEXAI="true"

# Model ID to use across agents (default: gemini-3.1-pro)
GEMINI_MODEL="gemini-3.1-pro"

# Alternative: an AI Studio / Vertex Express Mode API key instead of ADC.
# GEMINI_API_KEY=""

